# Copy to .env and fill in. Never commit .env.
# SPA app registration (Entra ID) client id and your tenant id
VITE_ENTRA_CLIENT_ID=<spa-app-client-id>
VITE_ENTRA_TENANT_ID=<tenant-id>
# Scope exposed by the API app registration
VITE_API_SCOPE=api://<api-app-client-id>/access_as_user
# Backend base URL (local Azure Functions host). In Azure Static Web Apps with a linked backend use /api
VITE_API_BASE_URL=http://localhost:7071/api
